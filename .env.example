# MongoDB connection string. With credentials: mongodb://user:password@host:27017/map-generator
MONGODB_URI=mongodb://127.0.0.1:27017/map-generator
# Database for app data (default: database from the URI path, else "map-generator").
MONGODB_DB=map-generator
# Database holding the MongoDB user (default: "admin"). Or use ?authSource=... in the URI.
# MONGODB_AUTH_SOURCE=admin
# Secret used to sign session cookies (min. 32 characters). Generate e.g. with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
